@*
    Mensajes de una sola vez enviados por los controladores con TempData:
      TempData["Exito"] = "Cliente registrado correctamente.";
      TempData["Error"] = "No se puede pasar a En tránsito sin envío.";
*@
@{
    var exito = TempData["Exito"] as string;
    var error = TempData["Error"] as string;
}
@if (!string.IsNullOrWhiteSpace(exito) || !string.IsNullOrWhiteSpace(error))
{
    <div class="pt-3" aria-live="polite">
        @if (!string.IsNullOrWhiteSpace(exito))
        {
            <div class="alert alert-success alert-dismissible fade show d-flex gap-2 mb-0" role="status" data-autocerrar>
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <div>@exito</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex gap-2 mb-0 mt-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>@error</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>
}
