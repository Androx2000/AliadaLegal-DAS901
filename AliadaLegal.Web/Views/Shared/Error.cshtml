@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="vacio my-5">
    <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
    <h1 class="h3 mt-3">Ocurrió un error inesperado</h1>
    <p>Intente de nuevo en unos minutos. Si el problema continúa, comuníquese con la administración.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small">Código de referencia: <span class="texto-mono">@Model.RequestId</span></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
