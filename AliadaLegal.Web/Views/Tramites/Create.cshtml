@model TramiteFormViewModel
@{
    ViewData["Title"] = "Nuevo trámite";
}

<div class="encabezado-pagina">
    <div>
        <nav class="migas" aria-label="Ruta"><a asp-action="Index">Trámites</a> / Nuevo</nav>
        <h1>Nuevo trámite</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="al-card al-card-body">
            <form asp-action="Create" method="post" novalidate data-evitar-doble-envio>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <section class="seccion-form">
                    <h2>Solicitud</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ClienteId" class="form-label">Cliente<span class="requerido" aria-hidden="true">*</span></label>
                            <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                                <option value="">Seleccione un cliente…</option>
                            </select>
                            <div class="form-text">¿No aparece? <a asp-controller="Clientes" asp-action="Create">Registre un cliente nuevo</a>.</div>
                            <span asp-validation-for="ClienteId"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TipoDocumentoId" class="form-label">Tipo de documento<span class="requerido" aria-hidden="true">*</span></label>
                            <select asp-for="TipoDocumentoId" asp-items="Model.TiposDocumento" class="form-select">
                                <option value="">Seleccione…</option>
                            </select>
                            <span asp-validation-for="TipoDocumentoId"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaisDestinoId" class="form-label">País donde se gestiona<span class="requerido" aria-hidden="true">*</span></label>
                            <select asp-for="PaisDestinoId" asp-items="Model.Paises" class="form-select">
                                <option value="">Seleccione…</option>
                            </select>
                            <div class="form-text">El aliado asignado debe pertenecer a este país.</div>
                            <span asp-validation-for="PaisDestinoId"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="4" maxlength="1000" placeholder="Datos del registro, nombres de los padres, fecha aproximada, etc."></textarea>
                            <div class="form-text">Uso interno. No se muestra en la consulta pública.</div>
                            <span asp-validation-for="Observaciones"></span>
                        </div>
                    </div>
                </section>

                <div class="alert alert-info d-flex gap-2 mt-4 mb-0">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <div>Al guardar se genera el <strong>código de seguimiento</strong> que el cliente usa para consultar su trámite.</div>
                </div>

                <div class="form-acciones">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Crear trámite</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
