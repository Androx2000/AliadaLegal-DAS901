@model EnvioFormViewModel
<form asp-action="RegistrarEnvio" method="post" data-evitar-doble-envio>
    <input type="hidden" asp-for="TramiteId" />
    <div class="mb-2">
        <label asp-for="EmpresaEnvio" class="form-label">Empresa de envío</label>
        <input asp-for="EmpresaEnvio" class="form-control" placeholder="DHL, FedEx, Correos…" required maxlength="100" />
    </div>
    <div class="mb-2">
        <label asp-for="NumeroGuia" class="form-label">Número de guía</label>
        <input asp-for="NumeroGuia" class="form-control texto-mono" required maxlength="150" />
    </div>
    <div class="mb-3">
        <label asp-for="FechaDespacho" class="form-label">Fecha de despacho</label>
        <input asp-for="FechaDespacho" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-acento w-100"><i class="bi bi-truck me-1" aria-hidden="true"></i>Guardar envío</button>
</form>
