@model AliadoFormViewModel
@* Campos compartidos por Create y Edit de aliados. *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<section class="seccion-form">
    <h2>Datos del aliado</h2>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Nombre" class="form-label">Nombre completo<span class="requerido" aria-hidden="true">*</span></label>
            <input asp-for="Nombre" class="form-control" autocomplete="name" placeholder="Lic. Ana Portillo" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="TipoAliado" class="form-label">Tipo<span class="requerido" aria-hidden="true">*</span></label>
            <select asp-for="TipoAliado" asp-items="Html.GetEnumSelectList<TipoAliado>()" class="form-select">
                <option value="">Seleccione…</option>
            </select>
            <span asp-validation-for="TipoAliado"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PaisAsignadoId" class="form-label">País donde gestiona<span class="requerido" aria-hidden="true">*</span></label>
            <select asp-for="PaisAsignadoId" asp-items="Model.Paises" class="form-select">
                <option value="">Seleccione…</option>
            </select>
            <div class="form-text">Solo podrá recibir trámites de este país.</div>
            <span asp-validation-for="PaisAsignadoId"></span>
        </div>
    </div>
</section>

<section class="seccion-form">
    <h2>Contacto</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Correo" class="form-label">Correo electrónico<span class="requerido" aria-hidden="true">*</span></label>
            <input asp-for="Correo" type="email" class="form-control" autocomplete="email" placeholder="nombre@correo.com" />
            <span asp-validation-for="Correo"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Telefono" class="form-label">Teléfono / WhatsApp<span class="requerido" aria-hidden="true">*</span></label>
            <input asp-for="Telefono" type="tel" class="form-control" autocomplete="tel" placeholder="+503 7000 0000" />
            <span asp-validation-for="Telefono"></span>
        </div>
    </div>
</section>
