@model AliadoFormViewModel
@{
    ViewData["Title"] = "Editar aliado";
}

<div class="encabezado-pagina">
    <div>
        <nav class="migas" aria-label="Ruta"><a asp-action="Index">Aliados</a> / Editar</nav>
        <h1>Editar aliado</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="al-card al-card-body">
            <form asp-action="Edit" method="post" novalidate data-evitar-doble-envio>
                <input type="hidden" asp-for="Id" />
                <partial name="_AliadoForm" model="Model" />

                <section class="seccion-form">
                    <h2>Estado</h2>
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" role="switch" />
                        <label asp-for="Activo" class="form-check-label">Aliado activo (puede recibir trámites)</label>
                    </div>
                    <div class="form-text">No se puede desactivar ni cambiar de país a un aliado con trámites abiertos.</div>
                </section>

                <div class="form-acciones">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
