@model ConsultaSeguimientoViewModel
@{
    ViewData["Title"] = "Consultar trámite";
    var r = Model.Resultado;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">

        <div class="text-center mt-4 mb-3">
            <h1 class="h2">Consulte su trámite</h1>
            <p class="texto-suave mb-0">Escriba el código de seguimiento que le enviamos. No necesita crear una cuenta.</p>
        </div>

        <div class="al-card al-card-body mb-3">
            <form asp-action="Buscar" method="post" novalidate data-evitar-doble-envio role="search">
                <label asp-for="Codigo" class="form-label">Código de seguimiento</label>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <input asp-for="Codigo" class="form-control form-control-lg input-codigo" placeholder="AL-2026-XXXXXX"
                           autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" data-mayusculas />
                    <button type="submit" class="btn btn-primary btn-lg text-nowrap"><i class="bi bi-search me-1" aria-hidden="true"></i>Consultar</button>
                </div>
                <span asp-validation-for="Codigo"></span>
                <div class="form-text">Ejemplo: <span class="texto-mono">AL-2026-K7M2QX</span>. Lo encuentra en el correo o mensaje de confirmación.</div>
            </form>
        </div>

        <div aria-live="polite">
            @if (Model.Buscado && r == null)
            {
                <div class="al-card">
                    <div class="vacio">
                        <i class="bi bi-question-circle" aria-hidden="true"></i>
                        <h2 class="h5 mt-3">No encontramos ese código</h2>
                        <p class="mb-0">Revise que esté completo, por ejemplo <span class="texto-mono">AL-2026-K7M2QX</span>. Si el problema continúa, escríbanos y le ayudamos.</p>
                    </div>
                </div>
            }
            else if (r != null)
            {
                <div class="al-card">
                    <div class="al-card-body border-bottom">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div>
                                <div class="small texto-suave">Trámite</div>
                                <div class="codigo-seguimiento fs-5">@r.CodigoSeguimiento</div>
                            </div>
                            <estado-badge texto="@r.Estado" clave="@r.EstadoClave" class="fs-6" />
                        </div>

                        <dl class="datos mt-3">
                            <div><dt>Documento</dt><dd>@r.TipoDocumento</dd></div>
                            <div><dt>País</dt><dd>@r.PaisDestino</dd></div>
                            <div><dt>Fecha de solicitud</dt><dd>@r.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                            <div><dt>Última actualización</dt><dd>@r.UltimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                            @if (!string.IsNullOrEmpty(r.NumeroGuia))
                            {
                                <div><dt>Envío</dt><dd>@r.EmpresaEnvio · <span class="texto-mono">@r.NumeroGuia</span></dd></div>
                            }
                        </dl>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">Avance</span><span class="texto-suave">@r.Progreso%</span>
                            </div>
                            <div class="al-progreso" role="progressbar" aria-label="Avance del trámite" aria-valuenow="@r.Progreso" aria-valuemin="0" aria-valuemax="100">
                                <span style="width:@(r.Progreso)%"></span>
                            </div>
                        </div>
                    </div>

                    <div class="al-card-body">
                        <h2 class="subtitulo-seccion mb-3">Etapas</h2>
                        <ol class="linea-tiempo">
                            @foreach (var hito in r.LineaDeTiempo)
                            {
                                var clase = hito.EsActual ? "actual" : hito.Completado ? "completado" : "pendiente";
                                <li class="@clase" aria-current="@(hito.EsActual ? "step" : null)">
                                    <span class="punto">
                                        @if (hito.Completado && !hito.EsActual)
                                        {
                                            <i class="bi bi-check" aria-hidden="true"></i>
                                        }
                                    </span>
                                    <div class="titulo">
                                        <i class="bi @EstadoTramiteUi.Icono(hito.EstadoClave) me-1" aria-hidden="true"></i>@hito.Estado
                                        @if (hito.EsActual)
                                        {
                                            <span class="visually-hidden">(etapa actual)</span>
                                        }
                                    </div>
                                    <div class="meta">
                                        @(hito.Fecha.HasValue ? hito.Fecha.Value.ToLocalTime().ToString("dd/MM/yyyy") : (hito.Completado ? "" : "Pendiente"))
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                </div>

                <p class="small texto-suave text-center mt-3">
                    <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Por su privacidad, esta página no muestra datos personales.
                    Guarde esta dirección para volver a consultar.
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
